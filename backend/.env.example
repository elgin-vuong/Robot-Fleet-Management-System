# Copy this file to backend/.env (or export these in your shell) and fill
# in real values. Never commit an actual .env file — it's gitignored.

# --- AI agent (backend/app/agent/llm_client.py) ---
# Required for POST /agent/chat to work at all. Without it, the endpoint
# returns 503 rather than crashing.
AI_API_KEY=
# Optional — defaults to "claude-sonnet-5" if unset.
AI_MODEL=

# --- Embeddings (backend/app/agent/embeddings_client.py) ---
# Required for POST /documents (ingestion) and the search_documents agent
# tool to work. Without it, those specific endpoints/tools return 503
# rather than crashing.
VOYAGE_API_KEY=
# Optional — defaults to "voyage-3.5-lite" if unset.
VOYAGE_MODEL=

# --- Auth (backend/app/auth.py) ---
# Optional — defaults to a dev-only placeholder if unset. Set a real,
# random secret before this ever runs anywhere but a local machine.
JWT_SECRET_KEY=

# --- Service addresses (backend/app/database.py, cache.py, kafka.py) ---
# All optional — default to localhost, which is correct for bare local dev
# (docker-compose infra only, app run via uvicorn/python directly on the
# host). Docker Compose and Kubernetes override these to point at service
# names instead (e.g. DATABASE_URL host "postgres", CACHE_HOST "redis",
# KAFKA_BOOTSTRAP_SERVERS "kafka:9092") — see docker-compose.yml and
# infrastructure/k8s/configmap.yaml.
DATABASE_URL=
CACHE_HOST=
CACHE_PORT=

# --- Observability (see docs/OBSERVABILITY.md) ---
# All optional. With none of these set, the app still runs exactly as
# before: JSON logs go to stdout at INFO level, and tracing initializes
# but exports nothing (no collector endpoint configured).
#
# Where to send OTLP traces (backend/app/observability/tracing.py). Unset
# = tracing initializes but spans are dropped rather than exported. Docker
# Compose/Kubernetes set this to the otel-collector service.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Logical service name attached to this process's spans/logs — lets you
# tell the API, telemetry consumer, and simulator apart in Jaeger/Grafana.
# Docker Compose/Kubernetes set this per-service; defaults to
# "robot-fleet-backend" if unset.
OTEL_SERVICE_NAME=
# Python logging level for the JSON formatter (backend/app/observability/logging.py).
LOG_LEVEL=
# Port the telemetry consumer's standalone Prometheus metrics HTTP server
# listens on (backend/app/consumers/telemetry_consumer.py) — it isn't an
# HTTP service otherwise, so this exists purely for Prometheus to scrape it.
METRICS_PORT=
# Battery percentage below which a robot counts toward the
# fleet_robots_unhealthy gauge (backend/app/observability/metrics.py).
FLEET_UNHEALTHY_BATTERY_THRESHOLD=
KAFKA_BOOTSTRAP_SERVERS=
